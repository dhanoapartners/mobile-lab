{
  "name": "appium-android-chrome",
  "private": true,
  "description": "Appium + WebdriverIO: the Practice Lab website in Chrome on Android, and a native demo app on Android and iOS.",
  "type": "module",
  "scripts": {
    "apps": "node scripts/download-apps.mjs",
    "test:web": "wdio run config/wdio.android.web.conf.ts",
    "test:android": "wdio run config/wdio.android.app.conf.ts",
    "test:ios": "wdio run config/wdio.ios.app.conf.ts",
    "report": "npx --yes allure-commandline@2.34.1 generate allure-results --clean -o allure-report",
    "typecheck": "tsc -p .",
    "triage": "node scripts/triage-basic.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.16.11",
    "@wdio/allure-reporter": "10.2.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "appium-xcuitest-driver": "12.22.8",
    "typescript": "5.6.3",
    "webdriverio": "10.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
